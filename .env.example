# ==============================================================================
# milbakman configuration. Copy to .env and edit:  cp .env.example .env
#
# Storage settings resolve per side: SOURCE_<NAME> / TARGET_<NAME> / BACKUP_<NAME>
# override the shared <NAME>. Leave a side's value unset to inherit it.
# Check the result any time with:  ./milvus.sh config [source|target] [--s3]
# The defaults below match the demo stack in docker-compose.primary.yml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Milvus instances
# ------------------------------------------------------------------------------
SOURCE_MILVUS_HOST=localhost
SOURCE_MILVUS_PORT=19530
SOURCE_MILVUS_MGMT_PORT=9091
SOURCE_MILVUS_ETCD=127.0.0.1:2379

TARGET_MILVUS_HOST=localhost
TARGET_MILVUS_PORT=19540
TARGET_MILVUS_MGMT_PORT=9092
TARGET_MILVUS_ETCD=127.0.0.1:2389
TARGET_MILVUS_ETCD_PORT=2389

MILVUS_USER=root
MILVUS_PASSWORD=Milvus
# MILVUS_ETCD_ROOT_PATH=by-dev

# ------------------------------------------------------------------------------
# 2. Shared storage settings (used by source, target and backup unless overridden)
#    S3_PROVIDER: local | minio | s3 | aws | gcp | gcpnative | azure | aliyun | tencent | hwc
#    STORAGE_AUTH: static | iam | default | sharedKey (azure) | serviceAccount (gcpnative)
#                  (empty = static; azure -> sharedKey; gcpnative -> serviceAccount if a key file is set)
#    Endpoint/port/SSL default per provider (minio: localhost:9000 no SSL; others: 443 + SSL).
# ------------------------------------------------------------------------------
S3_PROVIDER=minio
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=a-bucket
# STORAGE_AUTH=
# S3_SESSION_TOKEN=
# IAM_ENDPOINT=                       # only needed for MinIO IAM
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# GCP_CREDENTIALS_FILE=./gcp-sa.json   # gcpnative + serviceAccount

# Where each Milvus keeps its data in the bucket (never shared between sides)
SOURCE_S3_ROOT_PATH=files
TARGET_S3_ROOT_PATH=target-files

# ------------------------------------------------------------------------------
# 3. Per-side overrides (examples). Uncomment to give a side its own storage.
# ------------------------------------------------------------------------------
# Source Milvus on local disk (standalone, no object storage):
#   SOURCE_S3_PROVIDER=local
#   SOURCE_LOCAL_DATA_DIR=/srv/milvus/volumes/milvus/data    # host dir
#   SOURCE_LOCAL_MILVUS_PATH=/var/lib/milvus/data             # same dir as Milvus sees it
#
# Target Milvus on AWS S3 (cross-cloud migration):
#   TARGET_S3_PROVIDER=aws
#   TARGET_S3_ENDPOINT=s3.us-east-1.amazonaws.com
#   TARGET_S3_REGION=us-east-1
#   TARGET_S3_BUCKET=prod-milvus
#   TARGET_S3_ACCESS_KEY=AKIA...
#   TARGET_S3_SECRET_KEY=...
#   (or TARGET_STORAGE_AUTH=iam to use the instance role)
#
# Target Milvus on Google Cloud Storage via HMAC keys:
#   TARGET_S3_PROVIDER=gcp
#   TARGET_S3_ACCESS_KEY=GOOG...
#   TARGET_S3_SECRET_KEY=...
#
# Target Milvus on Azure Blob:
#   TARGET_S3_PROVIDER=azure
#   TARGET_AZURE_ACCOUNT_NAME=mystorageaccount
#   TARGET_AZURE_ACCOUNT_KEY=...
#   TARGET_S3_BUCKET=milvus                                   # container name
#
# Target Milvus on local disk (deploy-target bind-mounts this dir):
#   TARGET_S3_PROVIDER=local
#   TARGET_LOCAL_DATA_DIR=./data/target-milvus

# ------------------------------------------------------------------------------
# 4. Backup destination
#    BACKUP_STORAGE=local -> BACKUP_STORAGE_DIR: any path or mount (disk, NFS, SMB, USB)
#    BACKUP_STORAGE=s3    -> object storage; BACKUP_* overrides the shared settings,
#                            so backups can live in a different cloud/account.
# ------------------------------------------------------------------------------
BACKUP_STORAGE=local
BACKUP_STORAGE_DIR=./backups
BACKUP_COMPRESS=gzip            # gzip (uses pigz if installed) | none (keep a directory; best for huge backups)
# RESTORE_TMP_DIR=              # where archives are extracted (default: next to the archive)

BACKUP_S3_ROOT_PATH=milvus-backups
# BACKUP_S3_PROVIDER=aws
# BACKUP_S3_ENDPOINT=s3.eu-west-1.amazonaws.com
# BACKUP_S3_REGION=eu-west-1
# BACKUP_S3_BUCKET=milvus-backups-offsite
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. Cadence & local retention (backups kept per cadence folder; 0 = keep all)
# ------------------------------------------------------------------------------
DEFAULT_CADENCE=daily           # hourly | daily | weekly | monthly | manual
RETENTION_HOURLY=24
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12

# ------------------------------------------------------------------------------
# 6. Images & tuning
# ------------------------------------------------------------------------------
MILVUS_IMAGE=milvusdb/milvus:v2.4.15
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5
MILVUS_BACKUP_IMAGE=milvusdb/milvus-backup:v0.6.0
CLIENT_IMAGE=milvus-client:latest
# MILVUS_BACKUP_RUN_AS=1000:1000  # container user (default: you; root only when writing a local-disk Milvus)
# TRANSFER_CONCURRENCY=128
# BACKUP_CONCURRENCY_COLLECTIONS=4
# RESTORE_CONCURRENCY_COLLECTIONS=2
